# ─── AWS Configuration ───────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=

# ─── Cognito ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_USER_POOL_ID=
NEXT_PUBLIC_USER_POOL_CLIENT_ID=
NEXT_PUBLIC_IDENTITY_POOL_ID=

# ─── API ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ─── DynamoDB ────────────────────────────────────────────────────────────────
TABLE_NAME=DukaanOS-BusinessMemory
TABLE_REGION=us-east-1

# ─── S3 ──────────────────────────────────────────────────────────────────────
BUCKET_NAME=dukaanos-documents
BUCKET_REGION=us-east-1

# ─── Bedrock ─────────────────────────────────────────────────────────────────
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_HAIKU=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_MODEL_SONNET=anthropic.claude-3-5-sonnet-20241022-v2:0

# ─── Environment ─────────────────────────────────────────────────────────────
STAGE=local
LOG_LEVEL=debug

# ─── IMPORTANT: Never commit real values. This is a template only. ───────────
